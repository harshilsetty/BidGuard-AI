# ==============================================================================
# BidGuard Environment Configuration (.env.example)
# Copy this file to .env and supply your local or deployment values.
# NEVER commit actual secrets, keys, or passwords to version control!
# ==============================================================================

# AI / LLM Configuration (Primary Provider: Google Gemini API)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Database Configuration (PostgreSQL with pgvector)
# Async URL for FastAPI SQLAlchemy asyncpg
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/gem_compliance
# Sync URL for Alembic migrations and synchronous scripts
SYNC_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/gem_compliance
ALLOW_SQLITE_FALLBACK=false

# Vector Store / RAG Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8000
VECTOR_COLLECTION_NAME=gem_procurement_embeddings

# Document Storage & Extraction
STORAGE_PATH=./uploads
TENDER_STORAGE_PATH=./uploads/tenders
BIDDER_STORAGE_PATH=./uploads/bidders
MAX_UPLOAD_SIZE_MB=25

# Backend App Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO

# Frontend App Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
